# Quizasaurus — AI providers for the pack generator.
# Copy this file to .env and fill in ONLY the provider you want to use.
# Never commit your .env file.

# Local and free: install Ollama (https://ollama.com) and pull a model.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# Cloud providers (optional, bring your own key)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
