# Quizasaurus — AI providers.
# Copy this file to .env and fill in only what you use. Never commit your .env file.
# Check your setup with: npm run check-ai

# Which AI writes the packs: ollama | anthropic | openai | gemini
AI_PROVIDER=ollama
# Which AI reads scanned pages and photos. Local by default, so pages never leave
# the computer (ADR-0002). A cloud provider here sends the photos to that company.
VISION_PROVIDER=ollama

# Ollama — local and free (https://ollama.com). Pull the models first.
OLLAMA_HOST=http://localhost:11434
# Model that writes the packs (see `ollama list`), e.g. gpt-oss:20b
OLLAMA_MODEL=
# Model that reads pages: ollama pull qwen2.5vl:7b (6 GB)
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Claude (Anthropic) — bring your own key: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Default: claude-opus-5-5
ANTHROPIC_MODEL=

# OpenAI — bring your own key and choose a model that accepts images
OPENAI_API_KEY=
OPENAI_MODEL=

# Gemini (Google) — free tier available: https://aistudio.google.com/apikey
# Leave GEMINI_MODEL empty and run `npm run check-ai` to list the models your key can use.
GEMINI_API_KEY=
GEMINI_MODEL=
