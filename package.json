{
  "name": "quizasaurus",
  "version": "0.1.0",
  "private": true,
  "description": "Turn any lesson into games, with the AI you choose.",
  "license": "MIT",
  "author": "Marcelo Perea García",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelopereagarcia-sys/quizasaurus.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --exclude \"test/**/*.ollama.test.ts\" --exclude \"test/**/*.live.test.ts\"",
    "test:ollama": "vitest run test/extract.ollama.test.ts",
    "test:live": "vitest run test/providers.live.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "tsx src/cli/validate.ts",
    "extract": "tsx src/cli/extract.ts",
    "check-ai": "tsx src/cli/check-ai.ts",
    "generate": "tsx src/cli/generate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@napi-rs/canvas": "^1.0.10",
    "undici": "^7.30.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
